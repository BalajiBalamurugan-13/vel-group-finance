# ── Environment Variables (REQUIRED) ──────────────────────────────────────────
# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env to version control.
# NEVER share SUPABASE_SERVICE_ROLE_KEY with anyone.

# ── Supabase Configuration ─────────────────────────────────────────────────────
# Found in Supabase Dashboard → Settings → API
# This is the VEL Finance Group Finance Supabase project.
# NEVER use the Daily Collection project credentials here.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Application Configuration ──────────────────────────────────────────────────
# Options: development, production
APP_ENV=development

# Enable debug mode (true in development, MUST be false in production)
DEBUG=false

# ── CORS Configuration ─────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Development: http://localhost:5173 (Vite dev server)
# Production: set to your actual deployed frontend URL.
# DO NOT use * in production.
CORS_ORIGINS=http://localhost:5173
