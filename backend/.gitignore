*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# ── Virtual Environment ────────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.Python

# ── Testing ────────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
coverage.xml
*.cover

# ── Type Checking ──────────────────────────────────────────────────────────────
